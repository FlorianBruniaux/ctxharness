{
  "mcpServers": {
    "safe": {
      "url": "https://mcp.example.test",
      "headers": {
        "Authorization": "Bearer ${SAFE_MCP_TOKEN}"
      }
    },
    "literal": {
      "command": "npx",
      "args": ["-y", "example-mcp"],
      "env": {
        "API_KEY": "claude-secret-should-never-appear"
      }
    },
    "fallback": {
      "url": "https://mcp.example.test",
      "headers": {
        "Authorization": "Bearer ${CLAUDE_TOKEN:-json-fallback-should-never-appear}"
      }
    }
  }
}
